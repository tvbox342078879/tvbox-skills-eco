  {
   "id": "M01",
   "name": "会话台账未闭环条目",
   "check": "ledger_pending",
   "desc": "③会话台账：待同步=未收口(耗时)；已同步源库/已同步底包=半闭环(轻微，可补闭环标记)。首扫校准：原口径把半闭环当未解决，虚高",
   "threshold": ">0 即遗留",
   "cadence": "每次复盘闭环前",
   "severity": "耗时",
   "action": "待同步=真遗留须推进闭环；已同步*=半闭环（历史任务已完成、反哺状态停留中间态）——S022 决策：不改写历史记录，决策留痕台账，后续 log 直接写已闭环",
   "since_period": 1,
   "proven": "S111 受控单测实证（合成注入真阳性捕获+对照不误报，8/8 通过），恒0=对象真实合规"
